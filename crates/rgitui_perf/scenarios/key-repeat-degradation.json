{
  "name": "key-repeat-degradation",
  "description": "Holds the down arrow through 800 commits at a fixed 30Hz, timing each block of 100 separately. Delivery is paced off a clock rather than off the app, so events queue when the app falls behind — which is what a held key actually does, and the only way the backlog that makes it feel slow can build at all. A user holding a key does not experience an average; they experience the block they are in, and the question is whether block eight costs what block one did.",
  "corpus": "medium",
  "start_from": "cold",
  "steps": [
    { "wait_for": { "condition": "operation_idle", "timeout_ms": 120000 } },
    { "mark": { "mark": "rows-000-100" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-000-100" } },
    { "mark": { "mark": "rows-100-200" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-100-200" } },
    { "mark": { "mark": "rows-200-300" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-200-300" } },
    { "mark": { "mark": "rows-300-400" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-300-400" } },
    { "mark": { "mark": "rows-400-500" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-400-500" } },
    { "mark": { "mark": "rows-500-600" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-500-600" } },
    { "mark": { "mark": "rows-600-700" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-600-700" } },
    { "mark": { "mark": "rows-700-800" } },
    { "key": { "key": "down", "repeat": 100, "settle": { "rate": { "hz": 30.0 } } } },
    { "end_mark": { "mark": "rows-700-800" } },
    { "mark": { "mark": "recover" } },
    { "wait_for": { "condition": "operation_idle", "timeout_ms": 60000 } },
    { "end_mark": { "mark": "recover" } },
    { "snapshot": { "snapshot": "after-key-repeat" } }
  ]
}
